{
  "name": "speed-knowledge-client",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=client-web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "rm -rf node_modules **/**/node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "socket.io-client": "^4.8.3"
  },
  "pnpm": {
