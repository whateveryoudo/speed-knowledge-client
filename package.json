      "yjs": "13.6.31",
      "@speed-sheet/shared": "file:../speed-sheet/packages/shared",
      "@speed-sheet/core": "file:../speed-sheet/packages/core",
      "@speed-sheet/vue3": "file:../speed-sheet/packages/vue3",
      "@speed-sheet/extension-filter": "file:../speed-sheet/packages/extensions/extension-filter",
      "@speed-sheet/extension-formula": "file:../speed-sheet/packages/extensions/extension-formula",
      "@speed-sheet/extension-image": "file:../speed-sheet/packages/extensions/extension-image",
      "@speed-sheet/vue3-antd": "file:../speed-sheet/packages/vue3-antd"
    }
