# 复制为 .env 后按需修改（.env 勿提交）
# cp .env.example .env

VITE_SYS_TITLE=Speed Doc

# 生产留空（API 走同源 /api/v1）；本地 dev 可用 /api 走 vite proxy
VITE_APP_BASE_URL=

# 仅 dev 构建需要（vite proxy 目标）
VITE_APP_PROXY_URL=http://localhost:8010

# 协同 WebSocket 基址，不要带 /collaboration（代码里会拼接）
# 本地: ws://localhost:3004
# 线上: ws://你的域名或IP
VITE_APP_COLLABORATE_URL=ws://localhost:3004

# 通知 WebSocket/HTTP 基址
VITE_NOTIFICATION_URL=http://localhost:3004

VITE_ICONFONT_URL=//at.alicdn.com/t/c/font_3786040_fw7ho76n71.js
