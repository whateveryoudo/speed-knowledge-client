{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "src/**/*.ts", "src/**/*.tsx", "src/types/**/*.d.ts", "packages/**/*", "../../packages/sk-utils/src/validate.ts"],
  "exclude": ["src/**/__tests__/*"],
  "baseUrl": ".",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "jsx": "preserve", // 添加这行：保留 JSX 语法，让 Vite 插件处理
    "paths": {
      // "@/*": ["../../speed-components/src/*"],
      "@/*": ["../../speed-tiptap-editor/src/*"],
      "#sk-web/*": ["./src/*"],
      // 子路径须在 @speed-sheet/vue3 之前，避免 style.css 被解析成 index.ts/style.css
      "@speed-sheet/vue3/style.css": ["../../../speed-sheet/packages/vue3/dist/style.css"],
      "@speed-sheet/vue3-antd": ["../../../speed-sheet/packages/vue3-antd/src/index.ts"],
      "@speed-sheet/core": ["../../../speed-sheet/packages/core/src/index.ts"],
      "@speed-sheet/vue3": ["../../../speed-sheet/packages/vue3/src/index.ts"],
      "@speed-sheet/shared": ["../../../speed-sheet/packages/shared/src/index.ts"],
      "@speed-sheet/extension-formula": ["../../../speed-sheet/packages/extensions/extension-formula/src/index.ts"]
    },
  },
}
